{
  "azgaarDist": "upstream/azgaar/dist-electron/renderer",
  "mapsDir": "maps",
  "presetsFile": "layer-presets.json",
  "layerPresets": {
    "topography": [
      "lakes",
      "heightmap",
      "rivers",
      "ice",
      "scaleBar"
    ],
    "biomes": [
      "lakes",
      "biomes",
      "rivers",
      "ice",
      "scaleBar"
    ],
    "political": [
      "lakes",
      "rivers",
      "states",
      "provinces",
      "borders",
      "ice",
      "labels",
      "burgIcons",
      "scaleBar"
    ],
    "lore-clean": [
      "lakes",
      "biomes",
      "rivers",
      "labels",
      "scaleBar"
    ]
  },
  "exportsDir": "exports",
  "profileDir": ".browser-profile",
  "startup": "autosave",
  "allowEval": false,
  "server": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "browser": {
    "channel": "chrome",
    "executablePath": null,
    "headless": false,
    "viewport": {
      "width": 1920,
      "height": 1080
    },
    "readyTimeoutMs": 120000,
    "args": [],
    "fallbackChannels": [
      "msedge"
    ],
    "seedStorage": {
      "fmg-disable-click-arrow-tooltip": "true"
    },
    "openOnStart": false
  },
  "map": {
    "seed": null,
    "width": 1920,
    "height": 1080
  },
  "history": {
    "maxEntries": 30
  },
  "view": {
    "format": "png",
    "jpegQuality": 85,
    "settleMs": 200,
    "maxImageBytes": 900000,
    "textOnly": false
  },
  "export": {
    "format": "png",
    "jpegQuality": 92,
    "maxPixels": 10000,
    "clean": false,
    "cleanHide": [
      "#anchors",
      "#routes",
      "#markers",
      "#ice"
    ]
  },
  "bridge": {},
  "limits": {
    "listMax": 1000,
    "zoomMin": 0.5,
    "zoomMax": 80,
    "cameraMsMax": 5000,
    "scaleTolerance": 0.01,
    "mapSizeMin": 100,
    "mapSizeMax": 8000,
    "exportTimeoutMs": 120000
  },
  "azgaarPackage": "upstream/azgaar/package.json",
  "autosave": {
    "intervalSec": 60
  },
  "view3d": {
    "format": "png",
    "quality": 92,
    "hemisphereOffset": 0.25,
    "presets": {
      "satellite": {
        "satellite": true,
        "erosion": false
      },
      "heightmap": {
        "layerPreset": "topography"
      },
      "biomes": {
        "layerPreset": "biomes"
      }
    }
  }
}
