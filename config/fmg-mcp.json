{
  "azgaarDist": "upstream/azgaar/dist-electron/renderer",
  "mapsDir": "maps",
  "profileDir": ".browser-profile",
  "startup": "autosave",
  "allowEval": false,
  "server": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "browser": {
    "channel": "chrome",
    "executablePath": null,
    "headless": false,
    "viewport": {
      "width": 1280,
      "height": 720
    },
    "readyTimeoutMs": 120000,
    "args": [],
    "fallbackChannels": [
      "msedge"
    ],
    "seedStorage": {
      "fmg-disable-click-arrow-tooltip": "true"
    }
  },
  "map": {
    "seed": null,
    "width": 1280,
    "height": 720
  },
  "history": {
    "maxEntries": 30
  },
  "view": {
    "format": "png",
    "jpegQuality": 85,
    "settleMs": 200,
    "maxImageBytes": 900000
  },
  "bridge": {},
  "limits": {
    "listMax": 1000,
    "zoomMin": 0.5,
    "zoomMax": 80,
    "cameraMsMax": 5000,
    "mapSizeMin": 100,
    "mapSizeMax": 8000
  },
  "azgaarPackage": "upstream/azgaar/package.json",
  "autosave": {
    "intervalSec": 60
  }
}
